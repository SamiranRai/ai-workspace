{
  "name": "wxt-react-starter",
  "description": "Search every AI chat from one workspace.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "verify": "npm run compile && npm run lint && npm test && npm run build",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "web-ext": "^5.1.0",
    "wxt": "^0.20.27"
  }
}
